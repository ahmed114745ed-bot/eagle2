FROM php:8.2-cli AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    cron \
    supervisor \
    zip \
    unzip \
    git \
    curl \
    ffmpeg \
    vim \
    libavcodec-extra \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev  \
    pkg-config \
    libssl-dev \
    libicu-dev \
    libzip-dev \
    libjpeg-dev \
    libfreetype6-dev

# Clear cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN  pecl channel-update pecl.php.net \
    && printf "no\nno\nno\nno\nno\nno\nno\nno\nno\nno\nno\nno\n" | pecl install swoole \
    && docker-php-ext-enable swoole \
    && docker-php-ext-install pdo_mysql  mbstring exif pcntl bcmath gd zip opcache intl

RUN rm /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini

COPY docker/docker-php-ext-opcache.ini /usr/local/etc/php/conf.d/
COPY docker/docker-php-uploads.ini /usr/local/etc/php/conf.d/
COPY docker/99-myapp-pm.ini /usr/local/etc/php/conf.d/


# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app
RUN printenv | grep -v "no_proxy" >> /etc/environment
# Setup Laravel Cron Job
RUN echo "* * * * * . /etc/environment; cd /app && /usr/local/bin/php artisan schedule:run >> /var/log/cron.out.log 2>&1" > /etc/cron.d/laravel-scheduler
RUN chmod 0644 /etc/cron.d/laravel-scheduler && crontab /etc/cron.d/laravel-scheduler

# Copy application files
COPY . /app



# Setup supervisord configuration
COPY docker/octana-supervisor.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/octane-start.sh /app/docker/octane-start.sh
RUN chmod +x /app/docker/octane-start.sh



RUN env REDIS_HOST=172.17.0.1 \
    composer install --no-dev --no-interaction --ignore-platform-reqs   #--optimize-autoloader --no-scripts
 

RUN env REDIS_HOST=172.17.0.1 \
    composer require laravel/octane   --no-interaction --ignore-platform-reqs

RUN env REDIS_HOST=172.17.0.1 \ 
    php artisan octane:install
 

ENV OCTANE_WORKERS=4
ENV OCTANE_MAX_REQUESTS=500
ENV OCTANE_TASK_WORKERS=4

ENV OCTANE_SERVER="swoole"


RUN printf "%s\n" \
"OCTANE_WORKERS=${OCTANE_WORKERS}" \
"OCTANE_MAX_REQUESTS=${OCTANE_MAX_REQUESTS}" \
"OCTANE_SERVER=${OCTANE_SERVER}" \
"OCTANE_TASK_WORKERS=${OCTANE_TASK_WORKERS}" \
>> .env



COPY docker/octane.php /app/config/octane.php
#COPY docker/auth.php   /app/config/auth.php

RUN cat .env

RUN chmod -R 777 /app/storage
RUN chmod -R 777 /app/bootstrap
RUN chmod 777 /app/public/settings.json

RUN REDIS_HOST=172.17.0.1 \
    php artisan migrate --force
RUN REDIS_HOST=172.17.0.1 \
    php artisan optimize:clear

#COPY docker/nginx-octana.conf /etc/nginx/sites-available/default
#EXPOSE 80

# Expose port 9000
EXPOSE 8000
# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]


