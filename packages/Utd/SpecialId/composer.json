{
    "name": "utd/special-id",
    "description": "Special ID Package - Special ID Management System",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
