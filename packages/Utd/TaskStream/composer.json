{
    "name": "utd/task-stream",
    "description": "TaskStream Laravel Package - Task streaming, PK sessions, and room battles functionality",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "utd/room": "*"
    },
    "autoload": {
        "psr-4": {
            "Utd\\TaskStream\\": "src/",
            "Utd\\TaskStream\\Database\\": "Database/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Utd\\TaskStream\\TaskStreamServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
