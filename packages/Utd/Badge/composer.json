{
    "name": "utd/badge",
    "description": "Badge Laravel Package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Utd\\Badge\\": "src/",
            "Utd\\Badge\\Database\\": "Database/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Utd\\Badge\\BadgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
