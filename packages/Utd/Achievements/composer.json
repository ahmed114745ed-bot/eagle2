{
    "name": "utd/achievements",
    "description": "Achievement System Package with License Support",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
