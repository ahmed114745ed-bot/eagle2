{
    "name": "utd/room",
    "description": "Room Laravel Package - Core room functionality including microphones, visitors, categories, and more",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Utd\\Room\\": "src/",
            "Utd\\Room\\Database\\": "Database/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Utd\\Room\\RoomServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
