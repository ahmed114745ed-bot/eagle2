{
    "name": "utd/daily-prize",
    "description": "Daily Prize Package - Daily Login Gift Management System",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
