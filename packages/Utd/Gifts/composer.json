{
    "name": "utd/gifts",
    "description": "Complete Gifts Laravel Package - Gifts Management System",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "gifts", "presents", "management"],
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Utd\\Gifts\\": "src/",
            "Utd\\Gifts\\Database\\": "Database/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Utd\\Gifts\\GiftsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
