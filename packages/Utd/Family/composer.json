{
    "name": "utd/family",
    "description": "Family Management System for Utd Platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UTD Team",
            "email": "dev@utd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
