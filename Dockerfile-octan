FROM php:8.2-cli AS base

# Install system dependencies
RUN apt update && apt install -y \
    supervisor \
    zip \
    unzip \
    git \
    curl \
    ffmpeg \
    libavcodec-extra \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev  \
    libicu-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libjpeg-dev \
    libfreetype6-dev

# Clear cache
RUN apt clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN apt update && apt install -y --no-install-recommends \
    pkg-config \
    && pecl channel-update pecl.php.net \
    && printf "no\nno\nno\nno\nno\nno\nno\nno\nno\nno\nno\nno\n" | pecl install swoole \
    && docker-php-ext-enable swoole \
    && docker-php-ext-install pdo_mysql  mbstring exif pcntl bcmath gd zip opcache intl

RUN rm /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini

COPY docker/docker-php-ext-opcache.ini /usr/local/etc/php/conf.d/
COPY docker/docker-php-uploads.ini /usr/local/etc/php/conf.d/
COPY docker/99-myapp-pm.ini /usr/local/etc/php/conf.d/

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Layer caching: install dependencies before copying app code
COPY composer.json /app/
RUN env REDIS_HOST=172.17.0.1 \
    composer install --no-dev --no-interaction --ignore-platform-reqs --no-scripts

RUN env REDIS_HOST=172.17.0.1 \
    composer require laravel/octane --no-interaction --ignore-platform-reqs --no-scripts

# Copy application files
COPY . /app

# Rebuild autoload with full app code
RUN env REDIS_HOST=172.17.0.1 \
    composer dump-autoload --optimize --ignore-platform-reqs

RUN env REDIS_HOST=172.17.0.1 \
    php artisan octane:install --server=swoole

ENV OCTANE_WORKERS=6
ENV OCTANE_MAX_REQUESTS=500
ENV OCTANE_TASK_WORKERS=4

ENV OCTANE_SERVER="swoole"

RUN sed -i "/^OCTANE_/d" .env && sed -i "/^SESSION_DRIVER/d" .env && sed -i "/^LOG_LEVEL/d" .env && printf "%s\n" \
"OCTANE_WORKERS=${OCTANE_WORKERS}" \
"OCTANE_MAX_REQUESTS=${OCTANE_MAX_REQUESTS}" \
"OCTANE_SERVER=${OCTANE_SERVER}" \
"OCTANE_TASK_WORKERS=${OCTANE_TASK_WORKERS}" \
"SESSION_DRIVER=redis" \
"LOG_LEVEL=error" \
>> .env

# Setup supervisord configuration
COPY docker/octana-supervisor.conf /etc/supervisor/conf.d/supervisord.conf

COPY docker/octane.php /app/config/octane.php

RUN chmod -R 777 /app/storage /app/bootstrap
RUN chmod 777 /app/public/settings.json

# NOTE: Migrations run via CI/CD step (run_lumio_migrate), NOT during build.
# This prevents race conditions when both Dockerfiles build in parallel.
RUN REDIS_HOST=172.17.0.1 \
    php artisan optimize:clear

# Expose port 9000
EXPOSE 8000

# Start supervisord
CMD ["/usr/bin/supervisord", "-n"]
