### UTD Callback - Success (with signature)
< {%
    const timestamp = Math.floor(Date.now() / 1000).toString();
    const apiKey = "upk_038d0c0d88895b65c048332c278354656778782a90f737bb";
    const projectId = "yet94XI8gdwBLk0WZWdm";
    const secret = "30a5a37e75176d583dcd12b00168036e62cecedcb0d8701d679e853b324090a9";
    const body = request.body.tryGetSubstituted();
    const signData = timestamp + "." + apiKey + "." + projectId + "." + body;
    const signature = crypto.hmac.sha256().withTextSecret(secret).updateWithText(signData).digest().toHex();
    request.variables.set("timestamp", timestamp);
    request.variables.set("signature", signature);
    request.variables.set("apiKey", apiKey);
    request.variables.set("projectId", projectId);
%}
