FROM php:8.2-cli

# Install system dependencies
RUN apt update && apt install -y \
    cron \
    supervisor \
    zip \
    unzip \
    git \
    curl \
    ffmpeg \
    vim \
    libavcodec-extra \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    libzip-dev \
    libjpeg-dev \
    libfreetype6-dev

# Clear cache
RUN apt clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-jpeg --with-freetype
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip opcache intl

COPY docker/99-appjob-mem.ini /usr/local/etc/php/conf.d/

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Copy application files
COPY . /app

# Copy the crontab file
COPY docker/cron /etc/cron.d/app-cron

# Give execution rights to the cron job
RUN chmod 0644 /etc/cron.d/app-cron

# Create log file for cron
RUN touch /var/log/cron.log

RUN crontab -u root /etc/cron.d/app-cron

# Setup supervisord configuration
COPY docker/jobs-supervisor.conf /etc/supervisor/conf.d/supervisord.conf


#RUN sed -i 's/127.0.0.1/172.17.0.1/g' /app/.env
#RUN sed -i "s|/var/www/tempo/gcp.json|/app/gcp.json|g" /app/.env
#RUN ls -al



# Install application dependencies

RUN env REDIS_HOST=172.17.0.1 \
	 composer install --no-dev --optimize-autoloader    


RUN chmod -R 777 /app/storage
RUN chmod -R 777 /app/bootstrap
RUN chmod 777 /app/public/settings.json

# Migrations run at deploy time, not build time (requires DB access)
# optimize:clear runs at runtime since .env is bind-mounted

#COPY docker/nginx.conf /etc/nginx/sites-available/default
#EXPOSE 80


# Expose port 9000
#EXPOSE 9000

# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

