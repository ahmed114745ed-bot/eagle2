FROM php:8.2-cli

# Install system dependencies
RUN apt update && apt install -y \
    cron \
    supervisor \
    zip \
    unzip \
    git \
    curl \
    ffmpeg \
    libavcodec-extra \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    libzip-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && apt clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-jpeg --with-freetype
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip opcache intl

COPY docker/99-appjob-mem.ini /usr/local/etc/php/conf.d/

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Copy composer.json first for layer caching
COPY composer.json /app/

# Download dependencies (cached unless composer.json changes)
RUN env REDIS_HOST=172.17.0.1 \
	 composer install --no-dev --no-interaction --ignore-platform-reqs --no-scripts

# Now copy the rest of the application
COPY . /app

# Recreate storage dirs excluded by .dockerignore
RUN mkdir -p storage/framework/cache storage/framework/data storage/framework/sessions storage/framework/testing storage/framework/views storage/logs bootstrap/cache

# Re-dump autoloader with app files present
RUN env REDIS_HOST=172.17.0.1 \
	 composer dump-autoload --optimize --ignore-platform-reqs --no-scripts

# Copy the crontab file
COPY docker/cron /etc/cron.d/app-cron

# Give execution rights to the cron job
RUN chmod 0644 /etc/cron.d/app-cron

# Create log file for cron
RUN touch /var/log/cron.log

RUN crontab -u root /etc/cron.d/app-cron

# Setup supervisord configuration
COPY docker/jobs-supervisor.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod -R 777 /app/storage /app/bootstrap \
    && chmod 777 /app/public/settings.json

# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
