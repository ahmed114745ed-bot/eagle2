FROM php:8.2-cli

# Install system dependencies
RUN apt update && apt install -y \
    cron \
    supervisor \
    zip \
    unzip \
    git \
    curl \
    libavcodec-extra \
    ffmpeg \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev  \
    libicu-dev

# Clear cache
RUN apt clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip opcache intl

COPY docker/99-appjob-mem.ini /usr/local/etc/php/conf.d/

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app
RUN printenv | grep -v "no_proxy" >> /etc/environment

# Layer caching: install dependencies before copying app code
COPY composer.json /app/
RUN env REDIS_HOST=172.17.0.1 \
     composer install --no-dev --no-scripts

# Copy application files
COPY . /app

# Rebuild autoload with full app code
RUN env REDIS_HOST=172.17.0.1 \
     composer dump-autoload --optimize --ignore-platform-reqs

# Copy the crontab file
RUN printenv | grep -v "no_proxy" >> /etc/environment
COPY docker/cron /etc/cron.d/app-cron

# Give execution rights to the cron job
RUN chmod 0644 /etc/cron.d/app-cron && crontab /etc/cron.d/app-cron

# Create log file for cron
RUN touch /var/log/cron.log && chmod 666 /var/log/cron.log

# Setup supervisord configuration
COPY docker/supervisor.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod -R 777 /app/storage /app/bootstrap
RUN chmod 777 /app/public/settings.json

# NOTE: Migrations run via CI/CD step (run_lumio_migrate), NOT during build.
# This prevents race conditions when both Dockerfiles build in parallel.
RUN REDIS_HOST=172.17.0.1 \
    php artisan optimize:clear

RUN mkdir -p /var/log/supervisor /var/run/supervisor /app/storage/jobs-logs && chmod -R 777 /app/storage/jobs-logs

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
