        "phpunit/phpunit": "^10.4",
        "predis/predis": "^2.2",
        "pusher/pusher-php-server": "*",
        "spatie/laravel-google-cloud-storage": "^2.2",
        "spatie/laravel-translatable": "^6.11",
        "stripe/stripe-php": "^9.9",
        "utd/achievements": "*",
        "utd/agency": "*",
        "utd/charizma": "*",
        "utd/chat": "*",
        "utd/cp": "*",
        "utd/daily-prize": "*",
        "utd/events": "*",
        "utd/family": "*",
        "utd/form": "dev-achievmentPackage",
        "utd/gifts": "*",
        "utd/host-level": "*",
        "utd/lucky-box": "*",
        "utd/milestones": "*",
        "utd/moments": "*",
        "utd/pk": "*",
        "utd/ranking-reward": "*",
        "utd/reals": "*",
        "utd/room": "*",
        "utd/room-boom": "*",
        "utd/room-cup": "*",
        "utd/special-id": "*",
        "utd/switch-account": "*",
        "utd/task-stream": "*",
        "utd/users-wallet": "dev-achievmentPackage",
        "utd/vip": "*",
        "utd/bd": "*"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15.4",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.12",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Utd\\CP\\Database\\Seeders\\": "vendor/utd/cp/Database/Seeders/",
            "Utd\\LuckyBox\\Database\\Seeders\\": "vendor/utd/lucky-box/Database/Seeders/",
            "Utd\\Family\\": "packages/Utd/Family/src/"
        },
        "files": [
            "app/helpers.php",
            "app/helper/helpers.php",
            "app/helper/helperType.php",
            "app/Helpers/UserCoinLogHelper.php",
            "packages/Utd/Family/src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "helper": [
            "@php artisan clear-compiled",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:model --dir=\"App/Models\" --dir=\"Modules/*/Entities\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
