{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-openssl": "*",
        "beyondcode/laravel-websockets": "^1.14",
        "boogiefromzk/agora-token": "^1.0",
        "cmdotcom/text-sdk-php": "^2.2",
        "dflydev/apache-mime-types": "^1.0",
        "encore/laravel-admin": "^1.8",
        "firebase/php-jwt": "^6.9 ",
        "fruitcake/laravel-cors": "dev-develop",
        "google/apiclient": "2.15.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "imdhemy/google-play-billing": "^1.5.1",
        "imdhemy/laravel-purchases": "^1.3",
        "intervention/image": "^2.7",
        "jxlwqq/material-ui": "^1.0",
        "jxlwqq/watermark": "^1.0",
        "kreait/laravel-firebase": "^5.2",
        "laravel-admin-ext/chartjs": "^1.0",
        "laravel-admin-ext/cropper": "^1.0",
        "laravel-admin-ext/helpers": "2.*",
        "laravel-admin-ext/log-viewer": "^1.0",
        "laravel-admin-ext/media-player": "^1.1",
        "laravel-admin-extensions/multi-language": "^0.0.6",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.5",
        "maatwebsite/excel": "^3.1",
        "nafezly/payments": "*",
        "nwidart/laravel-modules": "8.0",
        "pbmedia/laravel-ffmpeg": "^8.3",
        "predis/predis": "^2.2",
        "pusher/pusher-php-server": "*",
        "spatie/laravel-google-cloud-storage": "^2.2",
        "stevebauman/location": "^7.4",
        "stripe/stripe-php": "^9.9"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "laravel/telescope": "^5.2",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php",
            "app/helper/helpers.php",
            "app/helper/helperType.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "helper": [
            "@php artisan clear-compiled",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:model --dir=\"App/Models\" --dir=\"Modules/*/Entities\""        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
